---
variant: flatcar
version: 1.0.0
storage:
  files:
    - path: /etc/hostname
      contents:
        inline: {{ inventory_hostname }}
      mode: 0644
      user:
        name: root
      group:
        name: root
    - path: /etc/hosts
      append:
        - inline: |
            127.0.0.1 {{ inventory_hostname }}.mgmt.{{ home_domain }} {{ inventory_hostname }}
            ::1 {{ inventory_hostname }}.mgmt.{{ home_domain }} {{ inventory_hostname }}
      mode: 0644
      user:
        name: root
      group:
        name: root
    - path: /etc/systemd/networkd.conf.d/ipv6-privacy-extensions.conf
      contents:
        inline: |
          [Network]
          IPv6PrivacyExtensions=yes
    # mgmt
    - path: /etc/systemd/network/5-eno1.network
      contents:
        inline: |
          [Match]
          Name=eno1*
          Name=!eno1.*

          [Network]
          Address={{ mgmt_ipv6_network }}5/64
          Address={{ mgmt_ipv6_network }}10/64
          Address={{ mgmt_ipv6_network }}53/64
          Address={{ mgmt_ipv4_network }}5/24
          Address={{ mgmt_ipv4_network }}10/24
          Address={{ mgmt_ipv4_network }}53/24
          DNS={{ mgmt_ipv6_nameserver }}
          DNS={{ mgmt_ipv4_nameserver }}
          Domains=mgmt.{{ home_domain }} {{ home_domain }} mgmt.{{ home_domain_old }} {{ home_domain_old }}
          VLAN=eno1.10
          VLAN=eno1.20
          VLAN=eno1.30
          VLAN=eno1.40
          VLAN=eno1.50
          VLAN=eno1.60
          VLAN=eno1.70

          [Route]
          Gateway={{ mgmt_ipv6_nameserver }}
          Gateway={{ mgmt_ipv4_nameserver }}
      mode: 0644
      user:
        name: root
      group:
        name: root
    # dmz
    - path: /etc/systemd/network/10-eno1.10.netdev
      contents:
        inline: |
          [NetDev]
          Name=eno1.10
          Kind=vlan

          [VLAN]
          Id=10
      mode: 0644
      user:
        name: root
      group:
        name: root
    - path: /etc/systemd/network/10-eno1.10.network
      contents:
        inline: |
          [Match]
          Name=eno1.10

          [Network]
          Address={{ dmz_ipv6_network }}5/64
          Address={{ dmz_ipv6_network }}53/64
          Address={{ dmz_ipv4_network }}5/24
          Address={{ dmz_ipv4_network }}53/24
          DNS={{ gateway_ipv6 }}
          DNS={{ dmz_ipv4_network }}1
          Domains=dmz.{{ home_domain }} dmz.{{ home_domain_old }}

          [Route]
          Gateway={{ gateway_ipv6 }}
          Gateway={{ dmz_ipv4_network }}1
          Destination={{ dmz_ipv6_network }}/64
          Destination={{ dmz_ipv4_network }}0/24
      mode: 0644
      user:
        name: root
      group:
        name: root
    # work
    - path: /etc/systemd/network/20-eno1.20.netdev
      contents:
        inline: |
          [NetDev]
          Name=eno1.20
          Kind=vlan

          [VLAN]
          Id=20
      mode: 0644
      user:
        name: root
      group:
        name: root
    - path: /etc/systemd/network/20-eno1.20.network
      contents:
        inline: |
          [Match]
          Name=eno1.20

          [Network]
          Address={{ work_ipv6_network }}5/64
          Address={{ work_ipv6_network }}53/64
          Address={{ work_ipv4_network }}5/24
          Address={{ work_ipv4_network }}53/24
          DNS={{ gateway_ipv6 }}
          DNS={{ work_ipv4_network }}1
          Domains=work.{{ home_domain }} work.{{ home_domain_old }}

          [Route]
          Gateway={{ gateway_ipv6 }}
          Gateway={{ work_ipv4_network }}1
          Destination={{ work_ipv6_network }}/64
          Destination={{ work_ipv4_network }}0/24
      mode: 0644
      user:
        name: root
      group:
        name: root
    # service
    - path: /etc/systemd/network/30-eno1.30.netdev
      contents:
        inline: |
          [NetDev]
          Name=eno1.30
          Kind=vlan

          [VLAN]
          Id=30
      mode: 0644
      user:
        name: root
      group:
        name: root
    - path: /etc/systemd/network/30-eno1.30.network
      contents:
        inline: |
          [Match]
          Name=eno1.30

          [Network]
          Address={{ service_ipv6_network }}5/64
          Address={{ service_ipv6_network }}10/64
          Address={{ service_ipv6_network }}53/64
          Address={{ service_ipv4_network }}5/24
          Address={{ service_ipv4_network }}10/24
          Address={{ service_ipv4_network }}53/24
          DNS={{ gateway_ipv6 }}
          DNS={{ service_ipv4_network }}1
          Domains=service.{{ home_domain }} service.{{ home_domain_old }}

          [Route]
          Gateway={{ gateway_ipv6 }}
          Gateway={{ service_ipv4_network }}1
          Destination={{ service_ipv6_network }}/64
          Destination={{ service_ipv4_network }}0/24
      mode: 0644
      user:
        name: root
      group:
        name: root
    # k8s00
    - path: /etc/systemd/network/40-eno1.40.netdev
      contents:
        inline: |
          [NetDev]
          Name=eno1.40
          Kind=vlan

          [VLAN]
